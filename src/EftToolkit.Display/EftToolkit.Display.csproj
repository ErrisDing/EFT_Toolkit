<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>EftToolkit.Display</RootNamespace>
    <AssemblyName>EftToolkit.Display</AssemblyName>
    <!-- The DisplayConfig structures declare fixed-size character buffers, and [LibraryImport] emits unsafe stubs. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EftToolkit.Core\EftToolkit.Core.csproj" />
  </ItemGroup>

</Project>
